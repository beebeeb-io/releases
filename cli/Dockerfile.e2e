# E2E test environment for the bb CLI.
# Run interactively:
#   docker build -t bb-e2e -f cli/Dockerfile.e2e .
#   docker run -it --rm bb-e2e
#
# Inside the container:
#   bb login        (opens browser — you'll see a code to paste)
#   bb ls           (list vault root)
#   bb push /tmp/hello.txt
#   bb pull <id>

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install bb via the canonical, checksum-verifying installer (get.beebeeb.io).
# BEEBEEB_CLI_UNMANAGED_INSTALL puts bb directly in /usr/local/bin and leaves
# shell profiles alone. Download first so the env var reaches the installer.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://get.beebeeb.io -o /tmp/bb-install.sh && \
    BEEBEEB_CLI_UNMANAGED_INSTALL=/usr/local/bin sh /tmp/bb-install.sh && \
    rm /tmp/bb-install.sh

# Create a test file to push
RUN echo "Hello from Beebeeb E2E test $(date)" > /tmp/hello.txt

WORKDIR /root

CMD ["bash", "-c", "\
echo ''; \
echo '  Beebeeb CLI E2E test environment'; \
echo '  ──────────────────────────────────'; \
echo ''; \
echo '  1. Run: bb login'; \
echo '     (A code will appear — open the URL in your browser to authorize)'; \
echo ''; \
echo '  2. Run: bb ls'; \
echo '  3. Run: bb push /tmp/hello.txt'; \
echo '  4. Run: bb pull <id from push output>'; \
echo ''; \
exec bash"]
